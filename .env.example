# ── Exchange ──────────────────────────────────────────────────────────────────
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# ── Trading mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true          # Change to false for live trading (after testing!)
MAX_PAIRS=25                # Top N pairs by Bitvavo 24h volume
PRIMARY_INTERVAL=5m         # Candle interval for strategy decisions

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hellacash:hellacash@localhost:5432/hellacash

# ── Social media sentiment ─────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hellacash/1.0
TWITTER_BEARER_TOKEN=       # Optional; snscrape used as fallback if empty

# ── Risk limits (do NOT change unless you understand the implications) ─────────
MAX_DRAWDOWN_PCT=8.0
MAX_POSITION_SIZE_PCT=20.0
MAX_DAILY_LOSS_EUR=200.0
MAX_OPEN_POSITIONS=5
MIN_TRADE_ROI_PCT=0.3
MIN_SIGNAL_CONFIDENCE=0.60

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Learning ───────────────────────────────────────────────────────────────────
OPTIMIZER_MIN_TRADES=50
MODEL_DIR=./models
